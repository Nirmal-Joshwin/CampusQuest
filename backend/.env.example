# Database connection string
# Defaults to SQLite automatically if PostgreSQL is not running: sqlite:///./campusquest.db
# For PostgreSQL: postgresql+psycopg2://postgres:postgres@localhost:5432/campusquest_db
DATABASE_URL=sqlite:///./campusquest.db

# API Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# JWT Secret for Auth Tokens
JWT_SECRET_KEY=cit-campusquest-secret-key-change-in-production

# Allowed CORS Origins (comma-separated, or * in development)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006


