# ==============================================================================
# CampusQuest - Comprehensive Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secret Variables
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env

# ------------------------------------------------------------------------------
# 2. Python & Backend
# ------------------------------------------------------------------------------
# Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/.venv/
backend/venv/

# Databases & Local Storage
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3
campusquest.db
backend/campusquest.db

# Distribution / Packaging
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 3. JavaScript, TypeScript & Frontend (React Native / Expo)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Expo & Metro Cache
.expo/
frontend/.expo/
.metro/
metro-cache/
*.tsbuildinfo

# Build Outputs
dist/
frontend/dist/
web-build/
frontend/web-build/

# Expo Prebuild / Bare Native Directories (if generated)
# Uncomment if using prebuild / bare workflow:
# android/
# ios/

# ------------------------------------------------------------------------------
# 4. Operating System & Editor Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. Temporary & Debug Files
# ------------------------------------------------------------------------------
*.log
tmp/
temp/
scratch/

